    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.3",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
